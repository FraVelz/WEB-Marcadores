# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only: Agent API, MCP, trash purge (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# URL del sitio (confirmación de email, Open Graph)
NEXT_PUBLIC_SITE_URL=https://web-marcadores.vercel.app

# Agent / MCP
AGENT_RATE_LIMIT_PER_MIN=120
TRASH_RETENTION_DAYS=30
# Bearer secret for GET/POST /api/agent/v1/cron/purge-trash
CRON_SECRET=

# Sentry (opcional; sin DSN = no-op)
NEXT_PUBLIC_SENTRY_DSN=
