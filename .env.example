# URL del sitio (para Open Graph / compartir). Ej: https://tu-app.vercel.app
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# Demo público (opcional): fuerza modo demo sin login. Útil para Vercel/demo.
# NEXT_PUBLIC_DEMO_MODE=true

# Supabase (obligatorio para producción)
# En Vercel: Settings → Environment Variables → añadir ambas
# En Supabase: Authentication → URL Configuration → Site URL = tu dominio Vercel
#             Authentication → URL Configuration → Redirect URLs = https://tu-dominio.vercel.app/**
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Script db:create-table (opcional)
SUPABASE_DB_PASSWORD=tu_contraseña_postgres

# Descripciones IA (pnpm run descriptions:generate)
OPENAI_API_KEY=sk-...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Project Settings > API > service_role

# Redundantes (no usar): NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY, SUPABASE_DB_URL
