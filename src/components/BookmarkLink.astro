---
/**
 * Enlace de marcador con icono (carga diferida)
 */
interface Props {
  href: string;
  title: string;
  showIcon?: boolean;
}

const { href, title, showIcon = true } = Astro.props;

function getFaviconUrl(url: string) {
  try {
    const host = new URL(url).hostname;
    return `https://www.google.com/s2/favicons?domain=${host}&sz=32`;
  } catch {
    return '';
  }
}

const domain = href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const favicon = showIcon ? getFaviconUrl(href) : '';
---

<a href={href} target="_blank" rel="noopener noreferrer" class="bookmark-link">
  {favicon && (
    <img
      src={favicon}
      alt=""
      width="16"
      height="16"
      loading="lazy"
      decoding="async"
      class="bookmark-icon"
    />
  )}
  <strong>{title}</strong>
  <span class="bookmark-domain">— {domain}</span>
</a>

<style>
  .bookmark-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--sl-color-text);
  }
  .bookmark-link:hover {
    color: var(--sl-color-accent);
  }
  .bookmark-icon {
    vertical-align: middle;
    flex-shrink: 0;
    border-radius: 4px;
  }
  .bookmark-domain {
    color: var(--sl-color-text-accent);
    font-size: 0.9em;
  }
</style>
